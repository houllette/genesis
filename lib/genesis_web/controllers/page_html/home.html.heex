<Layouts.app flash={@flash} current_scope={@current_scope} wide>
  <section class="workspace-hero">
    <p class="eyebrow">Genesis · world-building & story curation</p>
    <h1 class="display-title">A world worth returning to</h1>
    <p class="lede">
      Begin with a place and the people who belong there. Prepare an adventure, save it across gatherings, and keep its outcomes apart from shared history until review.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <.link navigate={~p"/worlds"} class="primary-button">Open your world library
      <.icon name="hero-arrow-right" class="size-4" /></.link>
      <.link href={~p"/users/register"} class="secondary-button">Create an account</.link>
    </div>
    <p class="helper-text mt-6">
      Native GM authoring is available. Full world-time reconciliation and AI/player play surfaces are still in development.
    </p>
  </section>
</Layouts.app>
